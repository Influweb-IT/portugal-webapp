REACT_APP_API_BASE_URL=/api
REACT_APP_DEFAULT_LANGUAGE="pt"
REACT_APP_FALLBACK_LANGUAGE="pt"
REACT_APP_CONTENT_URL=/assets
REACT_APP_USE_RECAPTCHA=true
# NOTE: replace this with you public recaptcha key
REACT_APP_RECAPTCHA_SITEKEY="6Ld6Y80bAAAAAMe_wCyBWijH7H6eauKWv_LSpRVP"
REACT_APP_TITLE="Gripenet"
REACT_APP_DESCRIPTION="A participatory surveillance platform in Portugal"
